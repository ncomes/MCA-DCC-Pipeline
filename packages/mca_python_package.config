# Which packages each DCC loads, and in what order.
#
# read by mca.common.startup.configs.config.packages_for(). Each depot name is a
# folder in this packages directory; the module it provides under `mca` comes from
# config.DEPOT_MODULES (mca-maya -> mya, mca-ai -> ai) unless a `module:` key says
# otherwise.
#
# mca-common is not listed under a DCC: it is already on sys.path by the time this
# is read, because it is the package doing the reading.
#
# mca-launcher and mca-mcp are deliberately absent. The launcher runs outside any
# DCC, and bootstrap.start_mcp() puts mca-mcp on the path itself, so neither is
# loaded through this file.

mca_directories:
  common:
    depots:
    - mca-common
    type: mcatools
    version: dev
  maya:
    depots:
    - mca-maya
    - mca-ai
    type: mcatools
    version: dev
